# Copy to .env.local and fill in. Never commit real values.

# Neon owner role, DIRECT (non -pooler) endpoint.
# Used only by scripts: db:migrate, db:setup-role, db:test-rls. Do NOT set this in Vercel.
DATABASE_URL="postgresql://neondb_owner:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Restricted runtime role `istiqamah_app` (no BYPASSRLS), pooled endpoint.
# Generated by `npm run db:setup-role`. This is the only DB URL the app uses.
DATABASE_APP_URL="postgresql://istiqamah_app:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Console → Project → Auth → Configuration → Auth URL
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth"

# 32+ random chars, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=""

# Public origin of the app (used for magic-link callbacks and the manifest)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
